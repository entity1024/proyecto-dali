# Copiá este archivo a .env.local y completá los valores

# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plantillarte"

# Auth.js — generá con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Storage — opciones: local | s3 | minio
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"

# S3 / MinIO (solo cuando STORAGE_PROVIDER != local)
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="plantillarte-assets"
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_PUBLIC_URL=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
